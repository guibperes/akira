#!/usr/bin/env bash
#
# akira-notifications - query and control the dunst notification daemon.
#                       Meant to back the waybar custom/notifications module.
#
# Usage:
#   akira-notifications OPERATION
#
# Operations:
#   pause-toggle   pause or resume notifications
#   get-paused     print true or false
#   get-icon       print the bell icon matching the current state
#   get-waiting    print how many notifications are queued while paused
#
# Options:
#   -h             this help

set -euo pipefail

ICON_ENABLED="󰂚"
ICON_DISABLED="󰂛"

usage() {
  awk 'NR>1 { if ($0 !~ /^#/) exit; sub(/^# ?/, ""); print }' "$0"
  exit "${1:-0}"
}

case "${1:-}" in
pause-toggle) dunstctl set-paused toggle ;;
get-paused) dunstctl is-paused ;;
get-waiting) dunstctl count waiting ;;
get-icon)
  if [ "$(dunstctl is-paused)" = "true" ]; then
    printf '%s\n' "$ICON_DISABLED"
  else
    printf '%s\n' "$ICON_ENABLED"
  fi
  ;;
-h | --help) usage 0 ;;
*)
  echo "error: unknown operation: ${1:-<none>}" >&2
  usage 2
  ;;
esac

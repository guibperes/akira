#!/bin/bash

# akira-mpris - waybar custom module with a scrolling media title
#
# Waybar has no built in scrolling, so this renders a moving window over the
# title instead of truncating it. It writes one JSON object per line and never
# exits, so the module must be declared with "return-type": "json" and without
# an "interval".

# Substring expansion has to count characters, not bytes
export LC_ALL=C.UTF-8

# Command line environment wins over the config file, so quick tests like
# `WIDTH=25 DELAY=0.15 akira-mpris` keep working
ENV_WIDTH="$WIDTH"
ENV_DELAY="$DELAY"
ENV_GAP="$GAP"
ENV_POLL_FRAMES="$POLL_FRAMES"
ENV_SCROLL_STEP="$SCROLL_STEP"
ENV_BAR_WIDTH="$BAR_WIDTH"

# Defaults, overridden by the config file below
WIDTH=35           # visible characters of the title
DELAY=0.60         # seconds between frames; below ~0.6 waybar tooltips break
SCROLL_STEP=1      # characters advanced per frame, compensates the slower tick
POLL_FRAMES=4      # query playerctl every N frames
GAP="  ·  "        # separator between the end and the restart
BAR_WIDTH=8        # cells in the progress bar, 0 disables it
IGNORED_PLAYERS="" # comma separated, passed to playerctl
PAUSED_ICON=""

# Progress bar glyphs. These are box drawing characters, present in
# JetBrainsMono Nerd Font; override them here if the font ever changes.
BAR_FILLED="━"
BAR_KNOB="╸"
BAR_EMPTY="─"

declare -A PLAYER_ICONS=([default]="")

CONFIG_FILE="${MPRIS_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/waybar/mpris.conf}"

if [ -r "$CONFIG_FILE" ]; then
  # A syntax error here would kill the module silently, so check first
  if bash -n "$CONFIG_FILE" 2>/dev/null; then
    source "$CONFIG_FILE"
  else
    echo "akira-mpris: syntax error in $CONFIG_FILE, using defaults" >&2
  fi
fi

WIDTH="${ENV_WIDTH:-$WIDTH}"
DELAY="${ENV_DELAY:-$DELAY}"
GAP="${ENV_GAP:-$GAP}"
POLL_FRAMES="${ENV_POLL_FRAMES:-$POLL_FRAMES}"
SCROLL_STEP="${ENV_SCROLL_STEP:-$SCROLL_STEP}"
BAR_WIDTH="${ENV_BAR_WIDTH:-$BAR_WIDTH}"

# Field separator for the playerctl template, chosen so it cannot show up
# inside a title
SEP=$'\x1f'

json_escape() {
  local text="$1"
  text=${text//\\/\\\\}
  text=${text//\"/\\\"}
  # Raw control characters are invalid inside a JSON string and would make
  # waybar drop the module without a word. Radio and podcast metadata does
  # occasionally carry them.
  text=${text//$'\n'/\\n}
  text=${text//$'\t'/\\t}
  text=${text//$'\r'/\\r}
  printf '%s' "$text"
}

# waybar redraws on every line it reads, and a module updating faster than
# roughly 0.6 s breaks tooltips across the WHOLE bar, not just its own
# (Waybar issue #890). Emitting only on change keeps the bar quiet in every
# state that is not actively scrolling: short titles, paused tracks, no
# player. Setting "tooltip": false on the module does not help.
last_payload=""

emit() {
  local payload
  payload=$(printf '{"text":"%s","tooltip":"%s","class":"%s"}' \
    "$(json_escape "$1")" "$(json_escape "$2")" "$3")

  [ "$payload" = "$last_payload" ] && return
  last_payload="$payload"
  printf '%s\n' "$payload"
}

# Raw position and length are requested alongside the formatted ones: the
# formatted values are for the tooltip, the raw microseconds drive the bar.
query() {
  playerctl --ignore-player="$IGNORED_PLAYERS" metadata --format \
    "{{status}}${SEP}{{playerName}}${SEP}{{duration(position)}}${SEP}{{duration(mpris:length)}}${SEP}{{position}}${SEP}{{mpris:length}}${SEP}{{title}}${SEP}{{artist}}" \
    2>/dev/null
}

# Returns true when the track reports a usable duration. Live streams do not,
# and neither do players that are still loading a track.
has_duration() {
  [[ "$1" =~ ^[0-9]+$ && "$2" =~ ^[0-9]+$ ]] && (($2 > 0))
}

# Thin progress bar. Emits blank cells of the same width when the duration is
# unknown, so the module never changes width.
progress() {
  local pos=$1 len=$2 width=$3

  ((width > 0)) || return
  has_duration "$pos" "$len" || {
    printf '%*s' "$width" ""
    return
  }

  ((pos > len)) && pos=$len

  local filled=$((pos * width / len)) i out=""
  for ((i = 0; i < width; i++)); do
    if ((i < filled - 1)); then
      out+="$BAR_FILLED"
    elif ((i == filled - 1)); then
      out+="$BAR_KNOB"
    else
      out+="$BAR_EMPTY"
    fi
  done
  printf '%s' "$out"
}

frame=0
offset=0
previous=""
status=""
player=""
position=""
length=""
pos_raw=""
len_raw=""
title=""
artist=""

while true; do
  if ((frame % POLL_FRAMES == 0)); then
    # -d '' instead of the default newline: a title containing a line break
    # would otherwise truncate the record and silently drop every field
    # after it.
    #
    # Process substitution rather than a herestring: <<< always appends a
    # newline, and since IFS is \x1f that newline is not stripped. With no
    # player running the record would come back as a single "\n" field, so
    # status was never empty and the module kept drawing a stray icon.
    IFS="$SEP" read -r -d '' status player position length pos_raw len_raw title artist < <(query)

    # The record itself still ends in a newline, which lands on the last field
    artist=${artist%$'\n'}

    # Control whitespace inside a title would render as a real line break in
    # the bar and push the module to two lines
    title=${title//[$'\n\r\t']/ }
    artist=${artist//[$'\n\r\t']/ }
  fi

  [[ -z "$artist" ]] && display="$title" || display="$title - $artist"
  frame=$((frame + 1))

  # No player, or nothing loaded: empty text hides the module.
  # status is always a single word, so any stray whitespace means a partial
  # or empty read and should be treated as "no player".
  status=${status//[$' \t\n\r']/}

  if [ -z "$status" ] || [ "$status" = "Stopped" ]; then
    emit "" "" "stopped"
    sleep "$DELAY"
    continue
  fi

  if [ "$status" = "Paused" ]; then
    icon="$PAUSED_ICON"
    class="paused"
  else
    # An empty player name is a bad subscript for an associative array and
    # would spam waybar's log, so fall through to the default key
    icon="${PLAYER_ICONS[${player:-default}]:-${PLAYER_ICONS[default]}}"
    class="playing"
  fi

  # Restart the scroll whenever the track changes
  if [ "$display" != "$previous" ]; then
    previous="$display"
    offset=0
  fi

  if ((${#display} <= WIDTH)); then
    visible="$display"
  else
    marquee="$display$GAP"
    visible="${marquee:offset:WIDTH}"

    # Wrap around: complete the window from the beginning of the title
    if ((${#visible} < WIDTH)); then
      visible="$visible${marquee:0:WIDTH-${#visible}}"
    fi

    # A paused track keeps its position instead of scrolling
    if [ "$status" = "Playing" ]; then
      offset=$(((offset + SCROLL_STEP) % ${#marquee}))
    fi
  fi

  # The bar sits after the title: the title window has a fixed width, so
  # keeping the only variable-width element at the end means nothing ever
  # gets pushed sideways.
  bar="$(progress "$pos_raw" "$len_raw" "$BAR_WIDTH")"
  text="${icon} ${visible}"
  [ -n "$bar" ] && text="${text}  ${bar}"

  # Exact timings live in the tooltip, where there is room for them
  if has_duration "$pos_raw" "$len_raw"; then
    tooltip="${display}"$'\n'"${position} / ${length}"
  else
    tooltip="${display}"$'\n'"${position}"
  fi

  emit "$text" "$tooltip" "$class"
  sleep "$DELAY"
done

  </defs>

  <rect width="1920" height="1080" fill="$AKIRA_BG"/>
  <rect width="1920" height="1080" fill="url(#dots)" opacity="0.55"/>

  <!-- The mark. No glow: the identity is sharp edges, not soft light. -->
  <text x="960" y="470" text-anchor="middle"
        font-family="Noto Sans CJK JP" font-weight="700" font-size="210"
        letter-spacing="18" fill="$AKIRA_ACCENT">アキラ</text>

  <!-- Hairline matched to the exact width of the mark above it -->

    <rect x="967" y="742" width="18" height="18" fill="$AKIRA_TEAL"/>
    <rect x="999" y="742" width="18" height="18" fill="$AKIRA_CYAN"/>
    <rect x="1031" y="742" width="18" height="18" fill="$AKIRA_BLUE"/>
    <rect x="1063" y="742" width="18" height="18" fill="$AKIRA_MAGENTA"/>
  </g>
</svg>

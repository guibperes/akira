  <text x="960" y="655" text-anchor="middle"
        font-family="JetBrains Mono" font-weight="800" font-size="90"
        letter-spacing="40" fill="$AKIRA_FG">AKIRA</text>

  <!-- Palette signature: the eight accents, in spectrum order -->
  <g>
    <rect x="839" y="742" width="18" height="18" fill="$AKIRA_RED"/>
    <rect x="871" y="742" width="18" height="18" fill="$AKIRA_ORANGE"/>

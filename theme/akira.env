# Akira アキラ — canonical palette
# theme/akira.env
#
# Single source of truth. Every hex in the setup originates here.

# ── Surfaces ─────────────────────────────────────────────────
export AKIRA_BG="#1A1B26"
export AKIRA_BG_DARK="#16161E"
export AKIRA_BG_ALT="#1F2335"
export AKIRA_SURFACE="#24283B"
export AKIRA_HIGHLIGHT="#292E42"
export AKIRA_BORDER="#414868"
export AKIRA_BORDER_HI="#7AA2F7"

# ── Text ─────────────────────────────────────────────────────
export AKIRA_FG="#C0CAF5"
export AKIRA_FG_DARK="#A9B1D6"
export AKIRA_COMMENT="#565F89"

# ── Accents ──────────────────────────────────────────────────
export AKIRA_RED="#F7768E"
export AKIRA_ORANGE="#FF9E64"
export AKIRA_YELLOW="#E0AF68"
export AKIRA_GREEN="#9ECE6A"
export AKIRA_TEAL="#73DACA"
export AKIRA_CYAN="#7DCFFF"
export AKIRA_BLUE="#7AA2F7"
export AKIRA_MAGENTA="#BB9AF7"
export AKIRA_MAGENTA_DARK="#9D7CD8"

# ── ANSI bright ──────────────────────────────────────────────
export AKIRA_BRIGHT_BLACK="#414868"
export AKIRA_BRIGHT_RED="#FF7A93"
export AKIRA_BRIGHT_GREEN="#B9F27C"
export AKIRA_BRIGHT_YELLOW="#F0D399"
export AKIRA_BRIGHT_BLUE="#7DA6FF"
export AKIRA_BRIGHT_MAGENTA="#BB9AF7"
export AKIRA_BRIGHT_CYAN="#A4DAFF"
export AKIRA_BRIGHT_WHITE="#D5D6DB"

# ── Semantic tokens ──────────────────────────────────────────
# What the interface means, not what color it is.
# Changing the visual identity means touching only this block.
export AKIRA_ACCENT="$AKIRA_RED"
export AKIRA_ACCENT_FG="$AKIRA_BG"
export AKIRA_HOVER="$AKIRA_SURFACE"
export AKIRA_OK="$AKIRA_GREEN"
export AKIRA_WARN="$AKIRA_YELLOW"
export AKIRA_ERROR="$AKIRA_RED"

# ── Alpha channels ───────────────────────────────────────────
# Hypr tools embed alpha in the hex string (rgba order).
export AKIRA_A_FULL="ff"
export AKIRA_A_HIGH="ee"
export AKIRA_A_MED="cc"
export AKIRA_A_LOW="80"

# ─────────────────────────────────────────────────────────────
# Derived values — do not edit below this line.
#
# 1. For every color, create a _RAW variant without the "#".
#    hyprlang treats "#" as a comment marker, so hyprlock and
#    friends need rgba(1a1b26ff) instead of #1A1B26.
# 2. Build AKIRA_VARS automatically so envsubst never falls out
#    of sync when a new color is added above.
# ─────────────────────────────────────────────────────────────

for _name in ${!AKIRA_@}; do
  _val="${!_name}"
  case "$_val" in
    '#'*) export "${_name}_RAW=${_val#\#}" ;;
  esac
done
unset _name _val

AKIRA_VARS=""
for _name in ${!AKIRA_@}; do
  case "$_name" in
    AKIRA_VARS | AKIRA_DIR_PATH) continue ;;
  esac
  AKIRA_VARS="$AKIRA_VARS \$$_name"
done
export AKIRA_VARS
unset _name

# Akira アキラ — eilmeldung
#
# GENERATED by scripts/theme.sh — do not edit by hand.
# Source: themes/akira.env

shadows = false
feed_list_focused_width = "25%"
article_list_focused_width = "75%"
article_list_focused_height = "40%"
article_content_focused_height = "60%"

date_format = "%d/%m/%Y %H:%M"
content_preferred_type = "markdown"
keep_articles_days = 999
sync_every_minutes = 60
startup_commands = ["sync", "focus articles"]
notify_after_sync = false

audio_enclosure_command = "mpv {url}"
video_enclosure_command = "mpv {url}"

feed_list = ['query: "Today Unread" today unread', "feeds", "* categories"]

share_targets = ["clipboard"]

[input_config.mappings]
"q" = ["quit"]

# ─────────────────────────────────────────────────────────────
# Border theme
# ─────────────────────────────────────────────────────────────
[border_theme]
framing = "connected"
focused = "plain"
unfocused = "plain"

# ─────────────────────────────────────────────────────────────
# Color palette
# ─────────────────────────────────────────────────────────────
[theme.color_palette]
background = "$AKIRA_BG"
foreground = "$AKIRA_FG"
muted = "$AKIRA_COMMENT"

# Search matches and yanked items
highlight = "$AKIRA_YELLOW"

# Feeds and focused borders
accent_primary = "$AKIRA_BLUE"

# Categories
accent_secondary = "$AKIRA_MAGENTA"

# Tags
accent_tertiary = "$AKIRA_CYAN"

# Saved queries
accent_quaternary = "$AKIRA_GREEN"

info = "$AKIRA_CYAN"
warning = "$AKIRA_WARN"
error = "$AKIRA_ERROR"

# ─────────────────────────────────────────────────────────────
# Component styles
# ─────────────────────────────────────────────────────────────
[theme.style_set]
# Panel borders
border = { fg = "muted" }
border_focused = { fg = "accent_primary" }

statusbar = { fg = "foreground", bg = "$AKIRA_ACCENT" }

header = { fg = "accent_primary", mods = ["bold"] }
paragraph = { fg = "foreground" }
article = { fg = "foreground" }
command_input = { fg = "foreground", bg = "$AKIRA_BG_DARK" }
inactive = { fg = "muted" }

tooltip_info = { fg = "info", bg = "background", mods= ["reversed"] }
tooltip_warning = { fg = "warning", bg = "background", mods= ["reversed"] }
tooltip_error = { fg = "error", bg = "background", mods= ["reversed"] }

# ── State modifiers, applied additively ──────────────────────
selected = { bg = "$AKIRA_HIGHLIGHT", mods = ["bold"] }

unread = { mods = ["bold"] }
read = { fg = "muted" }
highlighted = { fg = "background", bg = "highlight", mods = ["bold"] }
yanked = { fg = "background", bg = "highlight" }

unread_count = { fg = "accent_primary", mods = ["italic"] }
marked_count = { fg = "highlight", mods = ["italic"] }

{
  "reload_style_on_change": true,
  "layer": "top",
  "position": "top",
  "spacing": 0,
  "height": 45,
  "margin": 10,
  "modules-left": [
    "hyprland/workspaces",
    "custom/mpris"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "tray",
    "privacy",
    "gamemode",
    "cpu",
    "memory",
    "temperature",
    "bluetooth",
    "network",
    "custom/notifications",
    "pulseaudio",
    "battery"
  ],
  "hyprland/workspaces": {
    "on-click": "activate",
    "format": "{icon}",
    "format-icons": {
      "1": "一",
      "2": "二",
      "3": "三",
      "4": "四",
      "5": "五",
      "6": "六",
      "7": "七",
      "8": "八",
      "9": "九",
      "10": "十",
      "urgent": "！",
      "default": "・"
    }
  },
  "clock": {
    "format": "{:L%A %d %B %H:%M}",
    "on-click": "kitty --class=Calendar -e akira-calendar",
    "tooltip-format": "{calendar}",
    "calendar": {
      "mode": "year",
      "mode-mon-col": 3,
      "format": {
        "months": "<span color='#7DCFFF'><b>{}</b></span>",
        "days": "<span color='#C0CAF5'><b>{}</b></span>",
        "weeks": "<span color='#9ECE6A'><b>W{}</b></span>",
        "weekdays": "<span color='#E0AF68'><b>{}</b></span>",
        "today": "<span color='#F7768E'><b><u>{}</u></b></span>"
      }
    }
  },
  "cpu": {
    "interval": 5,
    "format": "󰍛 {usage}%",
    "on-click": "kitty --class=Monitor -e akira-monitor"
  },
  "memory": {
    "interval": 5,
    "format": " {percentage}%",
    "on-click": "kitty --class=Monitor -e akira-monitor"
  },
  "temperature": {
    "interval": 5,
    "format": " {temperatureC}°C",
    "on-click": "kitty --class=Monitor -e akira-monitor"
  },
  "network": {
    "format-icons": [
      "󰤯",
      "󰤟",
      "󰤢",
      "󰤥",
      "󰤨"
    ],
    "format": "{icon}",
    "format-wifi": "{icon}",
    "format-ethernet": "󰀂",
    "format-disconnected": "󰤮",
    "tooltip-format-wifi": "{essid} ({frequency} GHz)\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-ethernet": "⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-disconnected": "Disconnected",
    "interval": 3,
    "spacing": 1,
    "on-click": "kitty --class=Network -e akira-network"
  },
  "battery": {
    "format": "{icon} {capacity}%",
    "format-plugged": "",
    "format-full": "󰂅",
    "format-icons": {
      "charging": [
        "󰢜",
        "󰂆",
        "󰂇",
        "󰂈",
        "󰢝",
        "󰂉",
        "󰢞",
        "󰂊",
        "󰂋",
        "󰂅"
      ],
      "default": [
        "󰁺",
        "󰁻",
        "󰁼",
        "󰁽",
        "󰁾",
        "󰁿",
        "󰂀",
        "󰂁",
        "󰂂",
        "󰁹"
      ]
    },
    "tooltip-format-discharging": "{power:>1.0f}W↓ {capacity}%",
    "tooltip-format-charging": "{power:>1.0f}W↑ {capacity}%",
    "interval": 5,
    "on-click": "kitty --class=Monitor -e akira-monitor",
    "states": {
      "warning": 20,
      "critical": 10
    }
  },
  "bluetooth": {
    "format": "",
    "format-disabled": "󰂲",
    "format-connected": "",
    "tooltip-format": "Devices connected: {num_connections}",
    "on-click": "kitty --class=Bluetooth -e akira-bluetooth"
  },
  "pulseaudio": {
    "format": "{icon}",
    "on-click": "kitty --class=Wiremix -e wiremix",
    "on-click-right": "akira-audio volume-toggle",
    "tooltip-format": "Playing at {volume}%",
    "scroll-step": 5,
    "format-muted": "",
    "format-bluetooth": "󰂰",
    "format-icons": {
      "default": [
        "",
        "",
        ""
      ]
    }
  },
  "tray": {
    "icon-size": 14,
    "spacing": 16
  },
  "gamemode": {
    "format": "{glyph} {count}"
  },
  "custom/notifications": {
    "exec": "akira-notifications get-icon",
    "on-click": "akira-notifications pause-toggle",
    "restart-interval": 1,
    "tooltip": false
  },
  "privacy": {
    "icon-spacing": 16,
    "icon-size": 12,
    "modules": [
      {
        "type": "screenshare",
        "tooltip": true,
        "tooltip-icon-size": 24
      },
      {
        "type": "audio-in",
        "tooltip": true,
        "tooltip-icon-size": 24
      }
    ]
  },
  "custom/mpris": {
    "format": "{}",
    "return-type": "json",
    "exec": "akira-mpris",
    "escape": true,
    "on-click": "akira-audio play-pause"
  }
}

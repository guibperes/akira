# Main background; leave empty to inherit the terminal
theme[main_bg]="$AKIRA_BG"
# Main text color
theme[main_fg]="$AKIRA_FG"
# Box titles
theme[title]="$AKIRA_FG"
# Keyboard shortcut highlight
theme[hi_fg]="$AKIRA_BLUE"
# Selected item in the process list
theme[selected_bg]="$AKIRA_HIGHLIGHT"
theme[selected_fg]="$AKIRA_CYAN"
# Inactive or disabled text
theme[inactive_fg]="$AKIRA_COMMENT"
# Text drawn on top of graphs (uptime, network scale)
theme[graph_text]="$AKIRA_FG_DARK"
# Percentage meter background
theme[meter_bg]="$AKIRA_BORDER"
# Mini graphs and status text in the process detail view
theme[proc_misc]="$AKIRA_GREEN"

# Box outlines
theme[cpu_box]="$AKIRA_BORDER"
theme[mem_box]="$AKIRA_BORDER"
theme[net_box]="$AKIRA_BORDER"
theme[proc_box]="$AKIRA_BORDER"
theme[div_line]="$AKIRA_BORDER"

# Temperature gradient, cold to hot
theme[temp_start]="$AKIRA_BLUE"
theme[temp_mid]="$AKIRA_YELLOW"
theme[temp_end]="$AKIRA_RED"

# CPU gradient
theme[cpu_start]="$AKIRA_GREEN"
theme[cpu_mid]="$AKIRA_YELLOW"
theme[cpu_end]="$AKIRA_RED"

# Memory and disk: free
theme[free_start]="$AKIRA_MAGENTA"
theme[free_mid]="$AKIRA_BLUE"
theme[free_end]="$AKIRA_CYAN"

# Memory and disk: cached
theme[cached_start]="$AKIRA_CYAN"
theme[cached_mid]="$AKIRA_BLUE"
theme[cached_end]="$AKIRA_MAGENTA"

# Memory and disk: available
theme[available_start]="$AKIRA_YELLOW"
theme[available_mid]="$AKIRA_ORANGE"
theme[available_end]="$AKIRA_RED"

# Memory and disk: used
theme[used_start]="$AKIRA_GREEN"
theme[used_mid]="$AKIRA_YELLOW"
theme[used_end]="$AKIRA_RED"

# Network: download
theme[download_start]="$AKIRA_CYAN"
theme[download_mid]="$AKIRA_BLUE"
theme[download_end]="$AKIRA_MAGENTA"

# Network: upload
theme[upload_start]="$AKIRA_GREEN"
theme[upload_mid]="$AKIRA_YELLOW"
theme[upload_end]="$AKIRA_RED"

# Process usage gradient
theme[process_start]="$AKIRA_BLUE"
theme[process_mid]="$AKIRA_MAGENTA"
theme[process_end]="$AKIRA_RED"

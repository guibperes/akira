#? Akira アキラ — btop theme
#? https://github.com/guibperes/akira
#?
#? GENERATED by scripts/theme.sh — do not edit by hand.
#? Source: theme/akira.env

# Main background; leave empty to inherit the terminal
theme[main_bg]="#1A1B26"
# Main text color
theme[main_fg]="#C0CAF5"
# Box titles
theme[title]="#C0CAF5"
# Keyboard shortcut highlight
theme[hi_fg]="#7AA2F7"
# Selected item in the process list
theme[selected_bg]="#292E42"
theme[selected_fg]="#7DCFFF"
# Inactive or disabled text
theme[inactive_fg]="#565F89"
# Text drawn on top of graphs (uptime, network scale)
theme[graph_text]="#A9B1D6"
# Percentage meter background
theme[meter_bg]="#414868"
# Mini graphs and status text in the process detail view
theme[proc_misc]="#9ECE6A"

# Box outlines
theme[cpu_box]="#414868"
theme[mem_box]="#414868"
theme[net_box]="#414868"
theme[proc_box]="#414868"
theme[div_line]="#414868"

# Temperature gradient, cold to hot
theme[temp_start]="#7AA2F7"
theme[temp_mid]="#E0AF68"
theme[temp_end]="#F7768E"

# CPU gradient
theme[cpu_start]="#9ECE6A"
theme[cpu_mid]="#E0AF68"
theme[cpu_end]="#F7768E"

# Memory and disk: free
theme[free_start]="#BB9AF7"
theme[free_mid]="#7AA2F7"
theme[free_end]="#7DCFFF"

# Memory and disk: cached
theme[cached_start]="#7DCFFF"
theme[cached_mid]="#7AA2F7"
theme[cached_end]="#BB9AF7"

# Memory and disk: available
theme[available_start]="#E0AF68"
theme[available_mid]="#FF9E64"
theme[available_end]="#F7768E"

# Memory and disk: used
theme[used_start]="#9ECE6A"
theme[used_mid]="#E0AF68"
theme[used_end]="#F7768E"

# Network: download
theme[download_start]="#7DCFFF"
theme[download_mid]="#7AA2F7"
theme[download_end]="#BB9AF7"

# Network: upload
theme[upload_start]="#9ECE6A"
theme[upload_mid]="#E0AF68"
theme[upload_end]="#F7768E"

# Process usage gradient
theme[process_start]="#7AA2F7"
theme[process_mid]="#BB9AF7"
theme[process_end]="#F7768E"

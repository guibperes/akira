/*
 * Akira アキラ — libadwaita colors (GTK4)
 * configs/gtk-4.0/gtk.css  ->  ~/.config/gtk-4.0/gtk.css
 *
 * GENERATED by scripts/theme.sh — do not edit by hand.
 * Source: the palette env file
 *
 * libadwaita does not accept third party themes. What it does accept is an
 * override of its named colors from this file, which is the same idea as the
 * shared colors.css that waybar and wofi consume — only the syntax differs.
 *
 * Since libadwaita 1.6 the colors are standard CSS variables set on :root.
 * The older @define-color form still works but is on its way out, so this
 * file uses variables only.
 *
 * Requires `color-scheme` set to prefer-dark, otherwise libadwaita mixes its
 * own light values into everything not overridden here.
 */

:root {
  /* Window chrome */
  --window-bg-color: $AKIRA_BG;
  --window-fg-color: $AKIRA_FG;

  /* Content areas: file lists, text views, the image canvas in Loupe.
     Kept darker than the window, matching libadwaita's own relationship. */
  --view-bg-color: $AKIRA_BG_DARK;
  --view-fg-color: $AKIRA_FG;

  /* Header bars */
  --headerbar-bg-color: $AKIRA_BG_ALT;
  --headerbar-fg-color: $AKIRA_FG;
  --headerbar-border-color: $AKIRA_BORDER;
  --headerbar-backdrop-color: $AKIRA_BG;

  /* Sidebars: the places list in Nautilus. Same tone as the header bar so
     the top left corner reads as one continuous surface. */
  --sidebar-bg-color: $AKIRA_BG_ALT;
  --sidebar-fg-color: $AKIRA_FG;
  --sidebar-backdrop-color: $AKIRA_BG;
  --sidebar-border-color: $AKIRA_BORDER;
  --sidebar-shade-color: $AKIRA_BG_DARK;

  --secondary-sidebar-bg-color: $AKIRA_BG_ALT;
  --secondary-sidebar-fg-color: $AKIRA_FG;
  --secondary-sidebar-backdrop-color: $AKIRA_BG;
  --secondary-sidebar-border-color: $AKIRA_BORDER;
  --secondary-sidebar-shade-color: $AKIRA_BG_DARK;

  /* Raised surfaces */
  --card-bg-color: $AKIRA_SURFACE;
  --card-fg-color: $AKIRA_FG;
  --dialog-bg-color: $AKIRA_BG_ALT;
  --dialog-fg-color: $AKIRA_FG;
  --popover-bg-color: $AKIRA_SURFACE;
  --popover-fg-color: $AKIRA_FG;
  --thumbnail-bg-color: $AKIRA_SURFACE;
  --thumbnail-fg-color: $AKIRA_FG;

  /* Accent: selected rows, suggested actions, checked switches, links.
     The same red that marks the active workspace in waybar and the active
     tab in kitty. */
  --accent-bg-color: $AKIRA_ACCENT;
  --accent-fg-color: $AKIRA_ACCENT_FG;
  --accent-color: $AKIRA_ACCENT;

  /* Destructive actions deliberately use orange rather than red: the accent
     above is already red, and a delete button that looks identical to a
     confirm button is a real hazard. */
  --destructive-bg-color: $AKIRA_ORANGE;
  --destructive-fg-color: $AKIRA_ACCENT_FG;
  --destructive-color: $AKIRA_ORANGE;

  /* Status colors, matching the waybar module states */
  --success-bg-color: $AKIRA_OK;
  --success-fg-color: $AKIRA_ACCENT_FG;
  --success-color: $AKIRA_OK;

  --warning-bg-color: $AKIRA_WARN;
  --warning-fg-color: $AKIRA_ACCENT_FG;
  --warning-color: $AKIRA_WARN;

  --error-bg-color: $AKIRA_ERROR;
  --error-fg-color: $AKIRA_ACCENT_FG;
  --error-color: $AKIRA_ERROR;

  /* Square corners, the same rule as hyprland, waybar, wofi and dunst */
  --window-radius: 0;
}

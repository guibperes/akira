# Akira アキラ — spotify-player theme
# https://github.com/guibperes/akira
#
# GENERATED by scripts/theme.sh — do not edit by hand.
# Source: theme/akira.env
#
# Activate with `theme = "akira"` in app.toml

[[themes]]
name = "akira"

[themes.palette]
background = "$AKIRA_BG"
foreground = "$AKIRA_FG"

black = "$AKIRA_BG"
red = "$AKIRA_RED"
green = "$AKIRA_GREEN"
yellow = "$AKIRA_YELLOW"
blue = "$AKIRA_BLUE"
magenta = "$AKIRA_MAGENTA"
cyan = "$AKIRA_CYAN"
white = "$AKIRA_FG"

bright_black = "$AKIRA_BRIGHT_BLACK"
bright_red = "$AKIRA_BRIGHT_RED"
bright_green = "$AKIRA_BRIGHT_GREEN"
bright_yellow = "$AKIRA_BRIGHT_YELLOW"
bright_blue = "$AKIRA_BRIGHT_BLUE"
bright_magenta = "$AKIRA_BRIGHT_MAGENTA"
bright_cyan = "$AKIRA_BRIGHT_CYAN"
bright_white = "$AKIRA_BRIGHT_WHITE"

[themes.component_style]
block_title = { fg = "Magenta", modifiers = ["Bold"] }
border = { fg = "BrightBlack" }

playback_status = { fg = "Green", modifiers = ["Bold"] }
playback_track = { fg = "Blue", modifiers = ["Bold"] }
playback_artists = { fg = "Cyan" }
playback_album = { fg = "Yellow" }
playback_genres = { fg = "BrightBlack", modifiers = ["Italic"] }
playback_metadata = { fg = "BrightBlack" }
playback_progress_bar = { bg = "BrightBlack", fg = "Magenta" }
playback_progress_bar_unfilled = { bg = "BrightBlack" }

current_playing = { fg = "Green", modifiers = ["Bold"] }
page_desc = { fg = "Cyan", modifiers = ["Bold"] }
playlist_desc = { fg = "BrightBlack", modifiers = ["Dim"] }
table_header = { fg = "Blue", modifiers = ["Bold"] }
selection = { bg = "$AKIRA_HIGHLIGHT", modifiers = ["Bold"] }
secondary_row = {}
like = { fg = "Red" }

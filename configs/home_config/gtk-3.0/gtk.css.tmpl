/*
 * Akira アキラ — GTK3 colors
 * configs/gtk-3.0/gtk.css  ->  ~/.config/gtk-3.0/gtk.css
 *
 * GENERATED by scripts/theme.sh — do not edit by hand.
 * Source: theme/akira.env
 *
 * Companion to configs/gtk-4.0/gtk.css. GTK3 still uses @define-color, which
 * GTK4 has deprecated, so the two files cannot be shared.
 *
 * Two naming schemes are defined on purpose:
 *   - the libadwaita names, which adw-gtk3 honours
 *   - the legacy theme_* names, for anything still using stock Adwaita
 *
 * Every name here is GTK namespaced. Do NOT introduce short names like
 * "background" or "accent": GTK loads this file for every GTK3 application,
 * waybar and wofi included, and those two already define short names of their
 * own in the shared colors.css.
 */

/* ── libadwaita names, used by adw-gtk3 ──────────────────────────────── */
@define-color window_bg_color $AKIRA_BG;
@define-color window_fg_color $AKIRA_FG;

@define-color view_bg_color $AKIRA_BG_DARK;
@define-color view_fg_color $AKIRA_FG;

@define-color headerbar_bg_color $AKIRA_BG_ALT;
@define-color headerbar_fg_color $AKIRA_FG;
@define-color headerbar_border_color $AKIRA_BORDER;
@define-color headerbar_backdrop_color $AKIRA_BG;

@define-color sidebar_bg_color $AKIRA_BG_ALT;
@define-color sidebar_fg_color $AKIRA_FG;
@define-color sidebar_backdrop_color $AKIRA_BG;
@define-color sidebar_border_color $AKIRA_BORDER;

@define-color card_bg_color $AKIRA_SURFACE;
@define-color card_fg_color $AKIRA_FG;
@define-color dialog_bg_color $AKIRA_BG_ALT;
@define-color dialog_fg_color $AKIRA_FG;
@define-color popover_bg_color $AKIRA_SURFACE;
@define-color popover_fg_color $AKIRA_FG;
@define-color thumbnail_bg_color $AKIRA_SURFACE;
@define-color thumbnail_fg_color $AKIRA_FG;

@define-color accent_bg_color $AKIRA_ACCENT;
@define-color accent_fg_color $AKIRA_ACCENT_FG;
@define-color accent_color $AKIRA_ACCENT;

/* Orange rather than red, so a delete button never looks like a confirm
   button. The accent above is already red. */
@define-color destructive_bg_color $AKIRA_ORANGE;
@define-color destructive_fg_color $AKIRA_ACCENT_FG;
@define-color destructive_color $AKIRA_ORANGE;

@define-color success_bg_color $AKIRA_OK;
@define-color success_fg_color $AKIRA_ACCENT_FG;
@define-color success_color $AKIRA_OK;

@define-color warning_bg_color $AKIRA_WARN;
@define-color warning_fg_color $AKIRA_ACCENT_FG;
@define-color warning_color $AKIRA_WARN;

@define-color error_bg_color $AKIRA_ERROR;
@define-color error_fg_color $AKIRA_ACCENT_FG;
@define-color error_color $AKIRA_ERROR;

/* ── Legacy GTK3 names ───────────────────────────────────────────────── */
@define-color theme_bg_color $AKIRA_BG;
@define-color theme_fg_color $AKIRA_FG;
@define-color theme_base_color $AKIRA_BG_DARK;
@define-color theme_text_color $AKIRA_FG;

@define-color theme_selected_bg_color $AKIRA_ACCENT;
@define-color theme_selected_fg_color $AKIRA_ACCENT_FG;

@define-color theme_unfocused_bg_color $AKIRA_BG;
@define-color theme_unfocused_fg_color $AKIRA_FG_DARK;
@define-color theme_unfocused_base_color $AKIRA_BG_DARK;
@define-color theme_unfocused_text_color $AKIRA_FG_DARK;
@define-color theme_unfocused_selected_bg_color $AKIRA_SURFACE;
@define-color theme_unfocused_selected_fg_color $AKIRA_FG;

@define-color insensitive_bg_color $AKIRA_BG_ALT;
@define-color insensitive_fg_color $AKIRA_COMMENT;
@define-color insensitive_base_color $AKIRA_BG_DARK;

@define-color borders $AKIRA_BORDER;
